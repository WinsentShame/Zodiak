<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AssemblyVersion>0.0.1.2</AssemblyVersion>
		<FileVersion>0.0.1.2</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NativeDllMain" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<DirectPInvoke Include="minhook" />
		<NativeLibrary Include="src\libs\Minhook.lib" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
		<LinkerArg Include="/DEPENDENTLOADFLAG:0x800" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
	</ItemGroup>

</Project>